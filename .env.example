PORT=3001
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=turbo_cleaner
DB_PASSWORD=1234
DB_NAME=turbo_cleaner
DB_POOL_SIZE=10
DB_SSL=false
# Required when DB_SSL=true (for example, a Managed MySQL CA certificate)
DB_SSL_CA=

# Generate with: npm run hash-password -- "your-long-admin-password"
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value

# Optional email settings used by transporter.js
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
